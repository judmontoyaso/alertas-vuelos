# Codigo que la app pide para ver y crear alertas (inventalo tu).
ACCESS_TOKEN=

# Cadena aleatoria de 16+ caracteres. Vercel la envia sola al ejecutar el cron.
CRON_SECRET=

# Precios de Google Flights (https://serpapi.com/manage-api-key).
# El plan gratuito trae pocas busquedas al mes: cada alerta activa gasta una diaria.
SERPAPI_KEY=

# Supabase (Project Settings -> API). La clave es la secreta / service_role:
# solo vive en el servidor, nunca en el navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Avisos por correo con Resend (https://resend.com/api-keys). Opcional.
# Sin dominio verificado, Resend solo entrega al correo de tu propia cuenta.
RESEND_API_KEY=
# ALERT_FROM_EMAIL=Alertas de vuelos <alertas@tudominio.com>

# Avisos por Telegram: token del bot que entrega @BotFather. Opcional.
TELEGRAM_BOT_TOKEN=
